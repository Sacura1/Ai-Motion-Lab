PORT=3001
FRONTEND_URL=http://localhost:5173
# Railway PostgreSQL connection string. Run npm run db:migrate -w backend.
DATABASE_URL=
# Start with your Paystack test secret. Never put secrets in frontend code.
PAYSTACK_SECRET_KEY=
# Bot must be an administrator with invite permissions in both groups.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CREATOR_CHAT_ID=
TELEGRAM_MASTERCLASS_CHAT_ID=
# Optional: set BOTH to enable confirmation emails and email access recovery.
# Leave blank for payment -> Telegram access without automatic emails.
RESEND_API_KEY=
EMAIL_FROM=
# Configure only after checking the deployment's trusted reverse proxy chain.
TRUST_PROXY_HOPS=0
